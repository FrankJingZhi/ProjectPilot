# ProjectPilot 团队部署配置（复制为 .env 后填写）
# docker compose 会自动读取本文件同级的 .env

# 数据库密码（首次初始化后修改需同步修改数据库内密码）
POSTGRES_PASSWORD=projectpilot

# 前端对外端口
WEB_PORT=8080
# 允许跨域的前端地址（经 nginx 反代时同源，通常保持默认即可）
WEB_ORIGIN=http://localhost:8080

# JWT 签名密钥（必填，随机长字符串）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 初始管理员密码（仅管理员密码为空时生效；账号 owner@projectpilot.local）
ADMIN_INITIAL_PASSWORD=

# 模型调用（OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
