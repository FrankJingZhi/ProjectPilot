# 数据库连接（与 docker-compose.yml 默认值一致）
DATABASE_URL="postgresql://projectpilot:projectpilot@127.0.0.1:5433/projectpilot?schema=public"

# 服务端口
PORT=3000

# 允许跨域的前端地址
WEB_ORIGIN="http://localhost:5173"

# 模型调用（OpenAI 兼容统一接口，第 4 步启用）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"



# 认证：JWT 签名密钥（必填，随机长字符串，可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
JWT_SECRET=""

# 初始管理员密码（仅首次启动、管理员密码为空时生效；账号 owner@projectpilot.local）
ADMIN_INITIAL_PASSWORD=""
